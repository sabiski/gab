# Copiez vers /var/www/gabpharma/.env sur le VPS (chmod 640)
# Ne commitez JAMAIS ce fichier avec des secrets réels.

DJANGO_SETTINGS_MODULE=config.settings_prod
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=changez-moi-avec-openssl-rand-base64-48
DJANGO_ALLOWED_HOSTS=gabpharma.online,www.gabpharma.online
DJANGO_CSRF_TRUSTED_ORIGINS=https://gabpharma.online,https://www.gabpharma.online
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_LOG_FILE=/app/logs/django.log
DJANGO_LOG_LEVEL=INFO

SITE_URL=https://gabpharma.online

# MySQL Dokploy (port 3306) — ou PostgreSQL (DB_ENGINE=django.db.backends.postgresql, port 5432)
DB_ENGINE=mysql
DB_NAME=gabbdd
DB_USER=gabbdd
DB_PASSWORD=mot-de-passe-fort
DB_HOST=gabpharmavps-sabi-p7vvry
DB_PORT=3306

# Gunicorn (Docker / Dokploy : 0.0.0.0:8000 | VPS Nginx : 127.0.0.1:8001)
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# API mobile (Flutter) — origines autorisées si besoin
# CORS_ALLOWED_ORIGINS=https://app.gabpharma.ga

# --- SMTP Hostinger (support@gabpharma.online) ---
DEFAULT_FROM_EMAIL=Gab'Pharma <support@gabpharma.online>
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_TLS=0
EMAIL_USE_SSL=1
EMAIL_HOST_USER=support@gabpharma.online
EMAIL_HOST_PASSWORD=mot-de-passe-boite-mail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_TIMEOUT=30
# Variante si 465 échoue : PORT=587, USE_TLS=1, USE_SSL=0

# Notifications push (optionnel)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:noreply@gabpharma.ga

# Super administrateur (créé automatiquement au déploiement si mot de passe défini)
SUPERADMIN_USERNAME=admin
SUPERADMIN_EMAIL=admin@gabpharma.ga
SUPERADMIN_PASSWORD=changez-moi-mot-de-passe-fort
SUPERADMIN_FIRST_NAME=Super
SUPERADMIN_LAST_NAME=Admin
