# Copiez ce fichier en `.env` à la racine du projet pour la configuration locale.
# En production VPS : voir `.env.production.example` et `deploy/README.md`.

# URL publique du site (liens dans les e-mails)
SITE_URL=http://127.0.0.1:8000

# Développement local (laisser vide ou DJANGO_DEBUG=1)
# DJANGO_DEBUG=1
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- SMTP (production) ---
# Tant que EMAIL_HOST_USER et EMAIL_HOST_PASSWORD sont vides,
# les e-mails s'affichent dans la console du serveur Django.
DEFAULT_FROM_EMAIL=Gab'Pharma <noreply@gabpharma.ga>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Forcer un backend (optionnel) :
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- E-Billing (Digitech Africa — LAB) ---
# Sans credentials : les paiements en ligne restent simulés en développement.
# EBILLING_CLIENT_ID=
# EBILLING_CLIENT_SECRET=
# EBILLING_ENV=lab
# EBILLING_FLOW=redirect
# EBILLING_USE_SIMU=1
# EBILLING_EXPIRY_PERIOD=30
# Callback à configurer chez Digitech :
# https://votre-domaine/api/v1/payments/ebilling/callback/
