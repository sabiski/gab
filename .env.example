# Copiez ce fichier en `.env` à la racine du projet pour la configuration locale.
# En production, définissez ces variables dans l'environnement du serveur.

# URL publique du site (liens dans les e-mails)
SITE_URL=http://127.0.0.1:8000

# --- SMTP (production) ---
# Tant que EMAIL_HOST_USER et EMAIL_HOST_PASSWORD sont vides,
# les e-mails s'affichent dans la console du serveur Django.
DEFAULT_FROM_EMAIL=Gab'Pharma <noreply@gabpharma.ga>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Forcer un backend (optionnel) :
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
